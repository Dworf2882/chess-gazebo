<?xml version='1.0'?>
<sdf version='1.6'>
  <model name="fort_b">
    <static>false</static>
    
    <link name="body">
      <inertial>
        <mass>50</mass>
        <!-- Используем авто-вычисление через pose -->
        <inertia>
          <ixx>0.416</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.416</iyy>
          <iyz>0</iyz>
          <izz>0.416</izz>
        </inertia>
      </inertial>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://fort_b/mesh/fort_b.glb</uri>
            <scale> 0.3 0.3 0.3</scale>
          </mesh>
        </geometry>
      </visual>
      
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://fort_b/mesh/fort_b.glb</uri>
            <scale> 0.3 0.3 0.3</scale>
          </mesh>
        </geometry>
        
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    
    <!-- Задаем начальную позицию с небольшим отступом от пола -->
  </model>
</sdf>
