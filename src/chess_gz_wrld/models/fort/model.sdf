
<?xml version='1.0'?>
<sdf version='1.6'>
  <model name="fort">
    <static>false</static>
    
    <link name="body">
      <pose> 0 0 0 1.5707 0 0</pose>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://fort/mesh/fort.glb</uri>
            <scale> 0.3 0.3 0.3</scale>
          </mesh>
        </geometry>
      </visual>
      
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>1</radius>
            <length>3</length>
          </cylinder>
        </geometry>
        <pose> 0 0 0 1.5707 0 0</pose>
        
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    
    <!-- Задаем начальную позицию с небольшим отступом от пола -->
  </model>
</sdf>
