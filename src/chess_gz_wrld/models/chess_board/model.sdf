<?xml version="1.0"?>
<sdf version="1.10">
  <model name="chess">
    <static>true</static>
    <link name="body">
      <visual name="visual">
        <pose> 0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://chess_board/meshes/board.glb</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">

        <geometry>
          <box>
            <size>20 20 1.2 </size>
          </box>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

    </link>

  </model>
</sdf>
