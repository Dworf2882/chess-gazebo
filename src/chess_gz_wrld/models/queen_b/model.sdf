
<?xml version='1.0'?>
<sdf version='1.6'>
  <model name="queen_b">
    <static>false</static>
    
    <link name="body">
      <inertial>
        <mass>50</mass>
        <!-- Используем авто-вычисление через pose -->
        <inertia>
          <ixx>0.416</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.416</iyy>
          <iyz>0</iyz>
          <izz>0.416</izz>
        </inertia>
      </inertial>

      <visual name="visual">
        <pose> 0 0 0 1.5707 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://queen_b/mesh/queen_b.glb</uri>
            <scale> 0.2 0.2 0.2</scale>
          </mesh>
        </geometry>
      </visual>
      
      <collision name="collision">
        <pose> 0 0 3 0 0 0 </pose>
        <geometry>
          <cylinder>
            <radius>1</radius>
            <length>4</length>
          </cylinder>
        </geometry>

        
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    
    <!-- Задаем начальную позицию с небольшим отступом от пола -->
  </model>
</sdf>
