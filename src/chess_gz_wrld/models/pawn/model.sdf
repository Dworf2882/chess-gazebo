
<?xml version='1.0'?>
<sdf version='1.6'>
  <model name="pawn">
    <static>false</static>
    
    <link name="body">
      <inertial>
        <mass>50</mass>
        <!-- Используем авто-вычисление через pose -->
        <inertia>
          <ixx>0.416</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.416</iyy>
          <iyz>0</iyz>
          <izz>0.416</izz>
        </inertia>
      </inertial>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://pawn/meshes/pawn.glb</uri>
            <scale> 0.3 0.3 0.3</scale>
          </mesh>
        </geometry>
        <pose> 0 0 0 1.5707 0 0 </pose>

      </visual>
      
      <collision name="collision">
      <pose> 0 0 -.2 0 0 0 </pose>
        <geometry>
          <cylinder>
            <radius>1</radius>
            <length>2.5</length>
          </cylinder>

        </geometry>
        
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    
    <!-- Задаем начальную позицию с небольшим отступом от пола -->
  </model>
</sdf>
