
<?xml version='1.0'?>
<sdf version='1.6'>
  <model name="horse">
    <static>false</static>
    
    <link name="body">
      <pose> 0 0 0 1.5707 0 3.14</pose>
     

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://horse/mesh/horse.glb</uri>
            <scale> 0.3 0.3 0.3</scale>
          </mesh>
        </geometry>
        <pose> 0 0 -1.5 0 0 0</pose>
      </visual>
      
      <collision name="collision">
        <pose> 0 0 0 1.5707 0 0</pose>
        
        <geometry>
          <cylinder>
            <radius>1</radius>
            <length>4</length>
          </cylinder>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    
  </model>
</sdf>
