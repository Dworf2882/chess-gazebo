<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="world_demo">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

<model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.800000012 0.800000012 0.800000012 1</ambient>
            <diffuse>0.800000012 0.800000012 0.800000012 1</diffuse>
            <specular>0.100000001 0.100000001 0.100000001 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 -0.10000000000000001 0 0 0</pose>
      <self_collide>false</self_collide>
    </model>


    <!--light-->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <include>
        <pose>0 0 0 1.57079632679 0 0</pose>
        <static>true</static>
        <uri>model://chess_board</uri>
    </include>
  <!-- Белые фигуры (ставятся снизу, y = -2 ... -3) -->
  <include>
      <pose>-3 -2 0 0 0 0</pose>   <!-- Левая ладья -->
      <uri>model://pawn</uri>
  </include>
  <include>
      <pose>-2 -3 0 0 0 0</pose>   <!-- Конь -->
      <uri>model://horse</uri>
  </include>
  <include>
      <pose>-1 -2 0 0 0 0</pose>   <!-- Слон -->
      <uri>model://idk</uri>
  </include>
  <include>
      <pose>0 -3 0 0 0 0</pose>    <!-- Ферзь -->
      <uri>model://queen</uri>
  </include>
  <include>
      <pose>1 -2 0 0 0 0</pose>    <!-- Король -->
      <uri>model://king</uri>
  </include>
  <include>
      <pose>2 -3 0 0 0 0</pose>    <!-- Слон -->
      <uri>model://idk_b</uri>     <!-- если это белый слон -->
  </include>
  <include>
      <pose>3 -2 0 0 0 0</pose>    <!-- Конь -->
      <uri>model://horse_b</uri>   <!-- если это белый конь -->
  </include>
  <include>
      <pose>4 -3 0 0 0 0</pose>    <!-- Правая ладья -->
      <uri>model://fort</uri>
  </include>

  <!-- Чёрные фигуры (ставятся сверху, y = 2 ... 3) -->
  <include>
      <pose>-3 2 0 0 0 0</pose>    <!-- Левая ладья чёрная -->
      <uri>model://pawn_b</uri>
  </include>
  <include>
      <pose>-2 3 0 0 0 0</pose>    <!-- Конь чёрный -->
      <uri>model://horse_b</uri>
  </include>
  <include>
      <pose>-1 2 0 0 0 0</pose>    <!-- Слон чёрный -->
      <uri>model://idk_b</uri>
  </include>
  <include>
      <pose>0 3 0 0 0 0</pose>     <!-- Ферзь чёрный -->
      <uri>model://queen_b</uri>
  </include>
  <include>
      <pose>1 2 0 0 0 0</pose>     <!-- Король чёрный -->
      <uri>model://king_b</uri>
  </include>
  <include>
      <pose>2 3 0 0 0 0</pose>     <!-- Слон чёрный -->
      <uri>model://idk</uri>       <!-- если это чёрный слон -->
  </include>
  <include>
      <pose>3 2 0 0 0 0</pose>     <!-- Конь чёрный -->
      <uri>model://horse</uri>     <!-- если это чёрный конь -->
  </include>
  <include>
      <pose>4 3 0 0 0 0</pose>     <!-- Правая ладья чёрная -->
      <uri>model://fort_b</uri>
  </include>
  </world>
</sdf>
